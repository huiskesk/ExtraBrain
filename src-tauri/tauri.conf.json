{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExtraBrain",
  "version": "1.0.0",
  "identifier": "com.huiskeskevin.extrabrain",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' asset: blob: data: https:;"
    },
    "windows": [
      {
        "title": "ExtraBrain",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Modern note-taking app",
    "longDescription": "A modern, privacy-focused note-taking app with web clipping, PDF support, and notebook organization.",
    "copyright": "Copyright 2024 ExtraBrain",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {},
    "dialog": {},
    "shell": {},
    "window-state": {}
  }
}
